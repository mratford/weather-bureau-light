# Copy to .env and fill in. Get a key from https://datahub.metoffice.gov.uk/
# by subscribing to the Site Specific Blended Probabilistic Forecast product.
METOFFICE_API_KEY=

# Optional overrides.
# WBL_BASE_URL=https://data.hub.api.metoffice.gov.uk/mo-blended-prob-forecast-feature-svc/2.0.0
# Where the front page lands: a place name or postcode (Chelmsford, CM1 1JE) or a
# spot-site id (00350584). Defaults to Brentwood.
# WBL_DEFAULT_SITE=
# WBL_CACHE_TTL=900

# Where to listen. The default 127.0.0.1 accepts connections from this machine only;
# 0.0.0.0 opens it to the local network, which is what other devices need.
# WBL_HOST=127.0.0.1
# Avoid 5000 on a Mac: AirPlay Receiver holds it on every interface and answers
# 403 Forbidden, so requests never reach this app.
# WBL_PORT=5000
