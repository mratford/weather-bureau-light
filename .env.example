# Copy this file to .env and add a key from https://datahub.metoffice.gov.uk/.
# Subscribe to the Site Specific Blended Probabilistic Forecast product.
METOFFICE_API_KEY=
# Optional key for Met Office Weather Warnings (NSWWS).
METOFFICE_NSWWS_API_KEY=

# Optional settings.
# WBL_BASE_URL=https://data.hub.api.metoffice.gov.uk/mo-blended-prob-forecast-feature-svc/2.0.0
# Initial location: a place name, postcode (Chelmsford, CM1 1JE), or spot-site id
# (00350584). Defaults to Brentwood.
# WBL_DEFAULT_SITE=
# WBL_CACHE_TTL=900
# WBL_WARNINGS_TTL=60

# Listening address. 127.0.0.1 accepts connections from this machine only; 0.0.0.0
# also allows other devices on the local network to connect.
# WBL_HOST=127.0.0.1
# On macOS, avoid port 5000: AirPlay Receiver may occupy it and return 403 before
# requests reach this app.
# WBL_PORT=5000
