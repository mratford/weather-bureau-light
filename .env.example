# Copy to .env and fill in. Get a key from https://datahub.metoffice.gov.uk/
# by subscribing to the Site Specific Blended Probabilistic Forecast product.
METOFFICE_API_KEY=

# Optional overrides.
# WBL_BASE_URL=https://data.hub.api.metoffice.gov.uk/mo-blended-prob-forecast-feature-svc/2.0.0
# Where the front page lands: a place name or postcode (Chelmsford, CM1 1JE) or a
# spot-site id (00350584). Defaults to Brentwood.
# WBL_DEFAULT_SITE=
# WBL_CACHE_TTL=900
